  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "ML-Pipeline-Anomaly-Detection executive summary",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "### ML Anomaly Detection Platform\nHealth of the active Isolation Forest model: traffic, anomalies, latency, drift, errors and rollbacks."
      }
    },
    {
      "id": 2,
      "title": "Active model",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Current production model version loaded by the FastAPI inference service.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(active_model_version == 1) or on() label_replace(vector(0), \"model_version\", \"no active model\", \"\", \"\")",
          "legendFormat": "{{model_version}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "color": "text",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "no active model"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "title": "Requests (calls) \u2014 15m",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "API calls in the last 15 minutes; a /predict/batch call counts once.",
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "round(sum(increase(prediction_requests_total[15m]))) or vector(0)",
          "legendFormat": "requests (calls)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "title": "Anomaly rate \u2014 15m",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Anomalous rows as a percentage of rows scored (predictions_scored_total, so every /predict/batch row counts). Yellow at 7.5% and red at 10% are 1.5x and 2x the model contamination 0.05 in configs/model_config.yaml; update them if contamination changes.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "((sum(increase(anomalies_detected_total[15m])) or vector(0)) / clamp_min(sum(increase(predictions_scored_total[15m])), 1)) * 100 and on() (sum(increase(predictions_scored_total[15m])) > 0)",
          "legendFormat": "anomaly_rate",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 7.5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "noValue": "idle"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },

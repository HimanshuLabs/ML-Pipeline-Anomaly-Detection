    {
      "id": 7,
      "title": "Anomaly rate trend",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Anomalous rows as a percentage of rows scored (predictions_scored_total, so every /predict/batch row counts). Yellow at 7.5% and red at 10% are 1.5x and 2x the model contamination 0.05 in configs/model_config.yaml; update them if contamination changes.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "((sum(rate(anomalies_detected_total[5m])) or vector(0)) / clamp_min(sum(rate(predictions_scored_total[5m])), 0.001)) * 100 and on() (sum(rate(predictions_scored_total[5m])) > 0)",
          "legendFormat": "anomaly_rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 7.5
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "noValue": "idle"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "p95 latency",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "p95 latency of single predictions (/predict) over 5 minutes; budget 200 ms. Shows idle when there is no /predict traffic.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum(rate(prediction_latency_ms_bucket{endpoint=\"/predict\"}[5m])) by (le)) and on() (sum(rate(prediction_requests_total{endpoint=\"/predict\"}[5m])) > 0)",
          "legendFormat": "p95",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 150
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          },
          "noValue": "idle"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },

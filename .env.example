# Project 4 local environment template.
# Copy this file to .env for local runs. Do not commit .env.

PROJECT_NAME=project4-ml-pipeline-anomaly-detection
ENVIRONMENT=local
LOG_LEVEL=INFO

# PostgreSQL target for Project 4 metadata.
# Default assumes Project 2/3 warehouse PostgreSQL container pattern.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=marketing_analytics
POSTGRES_USER=project2
POSTGRES_PASSWORD=replace_me

# Local artifact registry.
MODEL_ARTIFACT_ROOT=artifacts/models

# MLflow experiment tracking (docker compose service mlflow, 127.0.0.1:5004).
# A record of training runs only; the Postgres registry and the active-model pointer
# decide what is served. Leave MLFLOW_TRACKING_URI empty to turn tracking off.
MLFLOW_TRACKING_URI=http://127.0.0.1:5004
# true: refuse training when the tracking server is unreachable; false: warn and go on.
PROJECT4_MLFLOW_REQUIRED=false
# Password of the dedicated role project4_mlflow (database project4_mlflow). Generate it
# into .env, never type it: see "Experiment tracking (MLflow)" in README.md.
PROJECT4_MLFLOW_DB_PASSWORD=
MLFLOW_DISABLE_TELEMETRY=true
GIT_PYTHON_REFRESH=quiet

# Online inference.
API_HOST=0.0.0.0
API_PORT=8001
PREDICTION_LATENCY_P95_BUDGET_MS=200

# Admin API token for /admin/* (X-Admin-Token header). Leave empty to keep admin
# endpoints disabled; set at least 16 random characters in .env, never here.
PROJECT4_ADMIN_TOKEN=

# Project 4's own PostgreSQL (docker compose service anomaly-postgres).
# Set the password in .env only; without it the anomaly-postgres container exits
# at startup (other compose services still start).
PROJECT4_POSTGRES_HOST=127.0.0.1
PROJECT4_POSTGRES_PORT=5435
PROJECT4_POSTGRES_DB=project4_ml
PROJECT4_POSTGRES_USER=manshu
PROJECT4_POSTGRES_PASSWORD=

# Monitoring.
PROMETHEUS_METRICS_ENABLED=true
# Grafana (docker compose service grafana, 127.0.0.1:3004) admin password. Set it in
# .env only; without it the grafana container refuses to start.
PROJECT4_GRAFANA_ADMIN_PASSWORD=
# Public Grafana URL used in share/snapshot links (host port 3004).
PROJECT4_GRAFANA_ROOT_URL=http://127.0.0.1:3004/
ALERT_LOG_PATH=logs/alerts/anomaly_alerts.jsonl
PREDICTION_LOG_PATH=logs/predictions/predictions.jsonl

# Password for the read-only role project5_reader (Project 5 reads the integration views).
# Set it in .env only; when empty, apply-schema keeps the role NOLOGIN.
PROJECT4_P5_READER_PASSWORD=

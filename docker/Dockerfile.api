FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONPATH=/app/src

WORKDIR /app

RUN groupadd --system app \
    && useradd --system --gid app --home-dir /app app

COPY requirements.txt constraints.txt /app/

RUN python -m pip install --root-user-action=ignore --upgrade "pip>=25,<26" \
    && python -m pip install --root-user-action=ignore -r /app/requirements.txt -c /app/constraints.txt

COPY api /app/api
COPY src /app/src
COPY configs /app/configs
COPY artifacts/models /app/artifacts/models

# Every tracked model bundle and the registry are copied (see .dockerignore), so the
# image can serve whatever version the shared pointer selects. The build checks the
# bundle of the pointer baked into the image, never a hardcoded version.
RUN mkdir -p /app/logs/predictions /app/logs/alerts \
    && test -f api/main.py \
    && test -f src/anomaly_detection/online_inference.py \
    && python -m anomaly_detection.bundle_check --active-model configs/active_model.yaml
RUN chown -R app:app /app

USER app

EXPOSE 8004

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8004/health', timeout=3).read()" || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8004"]

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONPATH=/app/src

WORKDIR /app

RUN groupadd --system app \
    && useradd --system --gid app --home-dir /app app

COPY requirements.txt constraints.txt /app/

RUN python -m pip install --root-user-action=ignore --upgrade "pip>=25,<26" \
    && python -m pip install --root-user-action=ignore -r /app/requirements.txt -c /app/constraints.txt

COPY src /app/src
COPY configs /app/configs
COPY artifacts/models /app/artifacts/models

# Every tracked model bundle and the registry are copied (see .dockerignore). The
# build checks the bundle of the pointer baked into the image, never a hardcoded version.
RUN mkdir -p /app/data/features/batch_scoring /app/logs/predictions /app/logs/alerts \
    && test -f src/anomaly_detection/batch_inference.py \
    && python -m anomaly_detection.bundle_check --active-model configs/active_model.yaml
RUN chown -R app:app /app

USER app

CMD ["python", "-m", "anomaly_detection.batch_inference", "--help"]
